  "products": [
    {
      "id": "ece21e3e790929bfdeb9a790",
      "name": "Nexaris Scientific (Zeta Potential Analyzer)",
      "categoryId": "a2588b40ca23f8e1f166a050",
      "sku": "",
      "overview": "A particle characterization system for measuring zeta potential, electrophoretic mobility and dispersion stability using Electrophoretic Light Scattering (ELS). Optional Dynamic Light Scattering (DLS) supports particle size analysis.",
      "description": "The Nexaris Scientific Zeta Potential Analyzer is a versatile analytical system designed for accurate evaluation of particle surface charge and dispersion stability. Based on Electrophoretic Light Scattering (ELS) technology, it enables reliable measurement of zeta potential and electrophoretic mobility across a wide range of sample types.\n\nThe system can be configured with Dynamic Light Scattering (DLS) capability for particle size characterization, allowing comprehensive analysis of nanoparticle and colloidal systems. Its sensitive optical detection, stable laser source, temperature control, and automated measurement functions provide consistent and reproducible results.\n\nAdvanced software supports automated data acquisition, measurement control, result analysis, graphical evaluation, trend comparison, and report generation. The instrument is suitable for nanomaterial research, pharmaceuticals, cosmetics, polymers, paints and coatings, food science, environmental studies, formulation development, and industrial quality control.\n\nThe Nexaris Scientific Zeta Potential Analyzer provides a dependable solution for researchers and laboratories requiring precise surface charge, particle stability, and dispersion characterization.",
      "catalogueUrl": "",
      "imageUrl": "/uploads/nexaris-zeta-potential-analyzer.png",
      "images": [
        "/uploads/nexaris-zeta-potential-analyzer.png"
      ],
      "features": [
        "Precise zeta potential characterization for evaluating particle surface charge and colloidal stability.",
        "Electrophoretic mobility measurement for detailed assessment of charged particles in liquid dispersions.",
        "Optional DLS particle sizing capability for combined particle size and zeta potential analysis.",
        "Broad analytical range suitable for nanoparticles, colloids, emulsions, suspensions, polymers and biomaterials."
      ],
      "specifications": [
        {
          "label": "System Configuration",
          "value": "Automated Zeta Potential & Particle Characterization Analyzer"
        },
        {
          "label": "Primary Measurement Technique",
          "value": "Electrophoretic Light Scattering (ELS)"
        },
        {
          "label": "Optional Particle Sizing",
          "value": "Dynamic Light Scattering (DLS)"
        },
        {
          "label": "Light Source",
          "value": "High-Stability Solid-State Laser, 633 nm"
        }
      ],
      "status": "published",
      "featured": false,
      "createdAt": "2026-09-25T12:11:06.750Z",
