PORT=5003
CLIENT_ORIGIN=http://localhost:5173

# EC2 production settings: copy these into the server's private .env file
# after the production domain and persistent data disk are ready.
# NODE_ENV=production
# CLIENT_ORIGIN=https://www.your-domain.example
# TRUST_PROXY_HOPS=1
# PERSISTENT_DATA_DIRECTORY=/var/lib/versatile-data
# ADMIN_SETUP_TOKEN=replace-with-a-long-random-secret

# Optional env-managed admin login. Set both values, then restart the API.
# ADMIN_LOGIN_EMAIL=admin@versatile.in
# ADMIN_LOGIN_PASSWORD=choose-a-long-unique-password
# Once both are set, the old stored login stops working by default.
# Only if you intentionally need both IDs: ADMIN_ALLOW_LEGACY_LOGIN=true
# Production: set NODE_ENV=production and CLIENT_ORIGIN to the exact HTTPS site origin.
# First production admin only: set ADMIN_SETUP_TOKEN and send it as X-Setup-Token.
# Alternatively create the admin locally before deploying the persistent store.
# Run one API process with this JSON store; multiple replicas require a database.
# If hosted behind exactly one trusted reverse proxy: TRUST_PROXY_HOPS=1
# Do not set a proxy hop count without checking your hosting topology.
# Optional durable email outbox location (must be on persistent storage).
# PERSISTENT_DATA_DIRECTORY below automatically uses mail-outbox/ inside it:
# MAIL_QUEUE_DIRECTORY=/absolute/persistent/path/mail-outbox
# Optional isolated data file (useful for local testing)
# DATA_FILE=/tmp/versatileinstruments-store.json
# Production with a persistent disk: set this to the disk mount path. Product
# data will be saved as store.json and uploaded images under uploads/ there.
# Example for a Render disk mounted at /var/data:
# PERSISTENT_DATA_DIRECTORY=/var/data
# Optional overrides when data and uploads use different mounted locations:
# UPLOAD_DIRECTORY=/absolute/persistent/path/uploads

# Future Amazon S3 product image/PDF storage. These values take effect only
# after the backend upload flow is migrated from the local persistent disk to S3.
# Keep the real values only in the private server .env file, never in GitHub.
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=replace-with-an-iam-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-an-iam-secret-key
# AWS_S3_BUCKET=versatile-instruments-assets

# Optional customer acknowledgements for Contact and product Quotations.
# Resend HTTPS API takes precedence over SMTP when configured (Render Free compatible).
# RESEND_API_KEY=re_replace-with-your-sending-key
# MAIL_FROM=Versatile Instruments <no-reply@your-verified-domain.example>
# Without an email provider, requests are still saved in the admin workspace.
# Use the exact SMTP host shown in your Zoho account's server configuration.
# SMTP_HOST=smtppro.zoho.in
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@your-domain.example
# SMTP_PASS=replace-with-your-app-password
# MAIL_FROM=Versatile Instruments <no-reply@your-domain.example>
# No team inbox is required; only the customer receives acknowledgement mail.

# Optional shared public HTTPS brochure URL. When set, every product uses this
# external PDF for its catalogue download; the PDF is not stored on this server.
# Share the Drive file with "Anyone with the link" and allow downloads first.
# SHARED_CATALOGUE_URL=https://your-public-provider.example/versatile-brochure.pdf
